diff --git a/drivers/cpufreq/qcom-cpufreq-hw.c b/drivers/cpufreq/qcom-cpufreq-hw.c
--- a/drivers/cpufreq/qcom-cpufreq-hw.c
+++ b/drivers/cpufreq/qcom-cpufreq-hw.c
@@ -495,4 +495,28 @@ static int qcom_cpufreq_hw_read_lut(struct platform_device *pdev,
 			dev_pm_opp_add(cpu_dev, freq * 1000, volt);
 	}
 
+	/* ============================================================ */
+	/* OVERCLOCK: Tambah entry frekuensi di atas stock LUT           */
+	/* Little cluster (cpu 0-3): 2265 MHz                           */
+	/* Big cluster   (cpu 4-7): 3171 MHz                             */
+	/* Ubah freq (dalam kHz) sesuai kebutuhan.                       */
+	/* ============================================================ */
+	if (cpumask_first(&c->related_cpus) < 4) {
+		/* Little cluster OC */
+		c->table[i].frequency = 2265000;
+		c->table[i].driver_data = i;
+		if (cpu_dev)
+			dev_pm_opp_add(cpu_dev, 2265000000, volt);
+		i++;
+		pr_info("qcom-cpufreq-hw: OC little cluster -> 2265 MHz\n");
+	} else {
+		/* Big cluster OC */
+		c->table[i].frequency = 3171000;
+		c->table[i].driver_data = i;
+		if (cpu_dev)
+			dev_pm_opp_add(cpu_dev, 3171000000, volt);
+		i++;
+		pr_info("qcom-cpufreq-hw: OC big cluster -> 3171 MHz\n");
+	}
+
 	c->table[i].frequency = CPUFREQ_TABLE_END;
 
 	if (cpu_dev)
